# ========================================================
# NAGRIK AI – Environment Variables & API Configuration
# ========================================================

# Firebase Configuration
# Obtain these from your Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Gemini AI Integration
# Obtain from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash

# Application Configuration
VITE_APP_NAME="NAGRIK AI"
VITE_APP_VERSION="2.0.0"
VITE_DEFAULT_COUNTRY_CODE="+91"
VITE_MAX_IMAGE_SIZE_MB=5

